#!/bin/bash
set -euo pipefail

# =========================================
# BrittonMethod-auto Full Production Setup
# Python 3.12, Virtual Environment, Dependencies
# World-Class, Commercial Ready
# =========================================

# Step 0: Ensure local Python bin is in PATH
export PATH="$HOME/.local/bin:$PATH"
echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc
source ~/.bashrc

# Step 1: Go to project root
cd ~/BrittonMethod-auto || { echo "Directory not found"; exit 1; }

# Step 2: Remove old virtual environment
rm -rf .venv

# Step 3: Update system and install build dependencies
sudo apt update
sudo apt install -y build-essential libpq-dev python3.12 python3.12-venv python3.12-dev python3-distutils curl wget git

# Step 4: Create fresh virtual environment and activate it
python3.12 -m venv .venv
source .venv/bin/activate

# Step 5: Upgrade pip, setuptools, wheel
pip install --upgrade pip setuptools wheel

# Step 6: Install critical packages individually (Python 3.12 compatible)
pip install "numpy>=2.3.0,<3" \
            "pandas>=2.3.0,<3" \
            "celery>=5.5.3,<6" \
            "Flask>=2.2,<3" \
            "SQLAlchemy>=1.4,<2" \
            "sqlalchemy-utils>=0.41,<1" \
            "psycopg2-binary>=2.9,<3" \
            "alembic>=1.11,<2" \
            "redis>=4.5,<5" \
            "rq>=1.1,<2" \
            "streamlit>=1.20,<2" \
            "uvicorn>=0.22,<1" \
            "requests>=2.28,<3" \
            "python-dotenv>=1.0,<2" \
            "beautifulsoup4>=4.11,<5" \
            "click>=8.1,<9"

# Step 7: Verify installation of critical dependencies
python -c "import numpy; import pandas; import celery; import flask; import sqlalchemy; import redis; import rq; import streamlit; print('✅ All critical dependencies installed and working!')"

# Step 8: Final info
echo "====================================="
echo "BrittonMethod-auto setup complete!"
echo "Virtual environment location: $(pwd)/.venv"
echo "Activate anytime with: source .venv/bin/activate"
echo "Python version: $(python --version)"
echo "Pip version: $(pip --version)"
echo "====================================="

