"""
Lazy imports to prevent circular import issues
"""

def get_britton_personas():
    from .britton_personas import BRITTON_PERSONAS
    return BRITTON_PERSONAS

def get_britton_underwriter_master():
    from .britton_underwriter_master import BRITTON_UNDERWRITER_PROMPT
    return BRITTON_UNDERWRITER_PROMPT

def get_britton_webscraper_master():
    from .britton_webscraper_master import BRITTON_WEBSCRAPER_MASTER
    return BRITTON_WEBSCRAPER_MASTER
